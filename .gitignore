# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Vidéos : tout est sur Bunny CDN depuis la migration 2026-05.
# Aucune vidéo ne doit revenir dans le repo. Le hook .githooks/pre-commit
# et l'Action guard-media-size.yml font la seconde barrière.
public/video/*.mp4
public/video/*.webm

# lokale Werkzeuge
.claude/settings.local.json
