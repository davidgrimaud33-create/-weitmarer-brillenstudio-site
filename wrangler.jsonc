{
  // Cloudflare Worker: liefert die statische Seite aus ./out und nimmt Terminanfragen unter /api/termin an.
  // Geheimnisse (RESEND_API_KEY, TURNSTILE_SECRET_KEY, N8N_WEBHOOK_URL, TERMIN_TO_EMAIL, TERMIN_TO_EMAIL_TEST)
  // gehören NICHT hierher, sondern ins Cloudflare-Dashboard bzw. `wrangler secret put`.
  "name": "weitmarer-brillenstudio-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "preview_urls": true,
  "vars": {
    "TERMIN_FROM_EMAIL": "Weitmarer Brillenstudio <termin@weitmarer-brillenstudio.de>"
  },
  // Testversion (Worker Preview "staging", Branch staging): erbt nichts von der Produktion.
  // Secrets der Testversion: `npx wrangler preview secret put NAME --name staging`.
  "previews": {
    "vars": {
      "TERMIN_FROM_EMAIL": "Weitmarer Brillenstudio <termin@weitmarer-brillenstudio.de>"
    }
  }
}
