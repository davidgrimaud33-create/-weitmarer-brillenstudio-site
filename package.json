{
  "name": "weitmarer-brillenstudio-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/bildgroessen.mjs",
    "dev": "next dev",
    "build": "node scripts/bildgroessen.mjs && next build",
    "start": "next start",
    "vorschau": "npm run build && wrangler dev",
    "typecheck:worker": "tsc -p worker",
